# Stripe / Payment Configuration (Test Mode)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_ENABLE_MOCK_PAYMENT="true"
